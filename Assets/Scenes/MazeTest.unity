  m_Script: {fileID: 11500000, guid: 64261e159176a4523bb55d2394e75e2f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AmbientTutorial
  _openingText: '<b>The AI is slipping fake things into your game.</b>

    Check
    your manual. Flag only what doesn''t match.'
  _openingDelayAfterBinder: 4.5
  _obviousFakeText: '<b>This doesn''t belong in your game.</b>

    The AI made it
    up. Press F to flag it.'
  _obviousFakeAiLine: Like my new asset? I made it myself.
  _genuineText: '<b>This one is from your game. It''s real.</b>

    Leave real things
    alone: wrong flags cost time.'
  _genuineAiLine: Go on, flag it. I dare you.
  _puzzleItemText: '<b>Real or AI-made? You can''t tell by looking.</b>

    Open
    your manual (I), find its page, then decide.'
  _barText: '<b>Sense-making bar (top left)</b>

    Grows most when you check your
    manual before flagging. The AI drains it.'
  _visionText: '<b>The AI is clouding your vision.</b>

    Check your manual and
    flag its fakes to see clearly again.'
  _visionAiLine: Getting hard to see?
  _visionTriggerStrength: 0.15
  _hintDuration: 8
  _gapBetweenHints: 0.6
  _triggerRange: 3
  _onlyOncePerDevice: 0
  _anchor: {x: 0.45, y: 0.65}
  _offset: {x: 0, y: 0}
  _scale: 2
  _useParchment: 1
